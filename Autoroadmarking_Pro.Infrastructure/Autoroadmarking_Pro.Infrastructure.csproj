<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Platforms>x64</Platforms>
    <RootNamespace>Autoroadmarking_Pro.Infrastructure</RootNamespace>
    <AssemblyName>Autoroadmarking_Pro.Infrastructure</AssemblyName>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Autoroadmarking_Pro.Domain\Autoroadmarking_Pro.Domain.csproj" />
    <ProjectReference Include="..\Autoroadmarking_Pro.Application\Autoroadmarking_Pro.Application.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3"
                      PrivateAssets="all" />
    <PackageReference Include="System.Text.Json"
                      Version="8.0.5" />
  </ItemGroup>
</Project>
